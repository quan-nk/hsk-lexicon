":[{"zh":"上课以前要先预习。","tokens":[["上课","shàng|kè"],["以前","yǐ|qián"],["要","yào"],["先","xiān"],["预习","yù|xí"],["。",""]],"target":[4],"en":"Before class you should preview the lesson first.","analysis":""},{"zh":"你预习新课了吗？","tokens":[["你","nǐ"],["预习","yù|xí"],["新","xīn"],["课","kè"],["了","le"],["吗","ma"],["？",""]],"target":[1],"en":"Have you previewed the new lesson?","analysis":""},{"zh":"我每天晚上都预习。","tokens":[["我","wǒ"],["每","měi"],["天","tiān"],["晚上","wǎn|shang"],["都","dōu"],["预习","yù|xí"],["。",""]],"target":[5],"en":"I preview the lesson every evening.","analysis":""}],"collocations":[],"related":[],"hv":null,"vn_note":"","hook":"","source":"compact"},{"id":"L3-0591","hanzi":"人民币","pinyin":"rénmínbì","meaning":"Renminbi (RMB), China's currency","senses":[{"pos":"noun","en":"Renminbi (RMB), China's currency"}],"measure":null,"note":"Prices: 一百 块 人民币. 块 is the spoken unit.","examples":[{"zh":"这个多少人民币？","tokens":[["这","zhè"],["个","gè"],["多少","duō|shao"],["人民币","rén|mín|bì"],["？",""]],"target":[3],"en":"How many RMB is this?","analysis":""},{"zh":"我想换人民币。","tokens":[["我","wǒ"],["想","xiǎng"],["换","huàn"],["人民币","rén|mín|bì"],["。",""]],"target":[3],"en":"I'd like to change US dollars into RMB.","analysis":""},{"zh":"这里可以用人民币吗？","tokens":[["这里","zhè|lǐ"],["可以","kě|yǐ"],["用","yòng"],["人民币","rén|mín|bì"],["吗","ma"],["？",""]],"target":[3],"en":"Can I use RMB here?","analysis":""}],"collocations":[],"related":[],"hv":null,"vn_note":"","hook":"","source":"compact"},{"id":"L3-0713","hanzi":"跳远","pinyin":"tiàoyuǎn","meaning":"long jump","senses":[{"pos":"verb","en":"long jump"}],"measure":null,"note":"","examples":[{"zh":"他跳远跳得很远。","tokens":[["他","tā"],["跳远","tiào|yuǎn"],["跳","tiào"],["得","de"],["很","hěn"],["远","yuǎn"],["。",""]],"target":[1],"en":"He jumps very far in the long jump.","analysis":""},{"zh":"学校明天有跳远比赛。","tokens":[["学校","xué|xiào"],["明天","míng|tiān"],["有","yǒu"],["跳远","tiào|yuǎn"],["比赛","bǐ|sài"],["。",""]],"target":[3],"en":"The school has a long jump competition tomorrow